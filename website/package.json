{
	"name": "gluegun-docs",
	"version": "0.0.1",
	"private": true,
	"packageManager": "pnpm@12.18.0",
	"bugs": "https://github.com/tylerbutler/gluegun/issues",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/tylerbutler/gluegun.git",
		"directory": "website"
	},
	"license": "MIT",
	"author": "Tyler Butler <tyler@tylerbutler.com>",
	"type": "module",
	"scripts": {
		"astro": "node scripts/reference-state.mjs && astro",
		"build": "node scripts/reference-state.mjs && astro build",
		"check:astro": "node scripts/reference-state.mjs && astro check",
		"check:reference": "node scripts/generate-reference.mjs --check",
		"clean": "rimraf dist *.tsbuildinfo *.done.build.log .astro",
		"dev": "node scripts/reference-state.mjs && astro dev",
		"generate:reference": "node scripts/generate-reference.mjs",
		"og": "node scripts/generate-og.ts",
		"preview": "node scripts/reference-state.mjs && astro preview",
		"start": "node scripts/reference-state.mjs && astro dev",
		"test:reference": "node --test scripts/generate-reference.test.mjs scripts/reference-state.test.mjs scripts/ignore-if-website-unchanged.test.mjs"
	},
	"dependencies": {
		"@astrojs/check": "^0.9.12",
		"@astrojs/markdown-remark": "^7.3.6",
		"@astrojs/starlight": "^0.42.10",
		"@fontsource-variable/atkinson-hyperlegible-next": "^5.3.0",
		"@fontsource-variable/chivo": "^5.3.0",
		"@fontsource-variable/jetbrains-mono": "^5.3.0",
		"astro": "^7.4.7",
		"sharp": "^0.35.5",
		"starlight-heading-badges": "^0.8.0",
		"starlight-links-validator": "^0.27.0",
		"starlight-llms-txt": "^0.12.0",
		"starlight-showcases": "^0.3.2",
		"starlight-sidebar-topics": "^0.9.0",
		"typescript": "~6.0.2"
	},
	"devDependencies": {
		"@fec/remark-a11y-emoji": "^4.0.2",
		"@types/culori": "^4.0.1",
		"culori": "^4.0.2",
		"rimraf": "^6.1.4",
		"satori": "^0.63.2",
		"subset-font": "^2.9.0"
	}
}
